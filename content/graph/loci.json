[
  {
    "id": "sj7-julu",
    "text": "shi-ji",
    "juan": 7,
    "juanTitle": "项羽本纪",
    "layer": "正文",
    "edition": "中华书局点校本",
    "page": "—",
    "pageUnverified": true,
    "excerpt": "项羽乃悉引兵渡河，皆沉船，破釜甑，烧庐舍，持三日粮，以示士卒必死，无一还心。"
  },
  {
    "id": "sj7-hongmen-fan",
    "text": "shi-ji",
    "juan": 7,
    "juanTitle": "项羽本纪",
    "layer": "正文",
    "edition": "中华书局点校本",
    "page": "—",
    "pageUnverified": true,
    "excerpt": "范增数目项王，举所佩玉玦以示之者三，项王默然不应。"
  },
  {
    "id": "sj7-hongmen-bo",
    "text": "shi-ji",
    "juan": 7,
    "juanTitle": "项羽本纪",
    "layer": "正文",
    "edition": "中华书局点校本",
    "page": "—",
    "pageUnverified": true,
    "excerpt": "楚左尹项伯者，项羽季父也，素善留侯张良。"
  },
  {
    "id": "sj7-pengcheng",
    "text": "shi-ji",
    "juan": 7,
    "juanTitle": "项羽本纪",
    "layer": "正文",
    "edition": "中华书局点校本",
    "page": "—",
    "pageUnverified": true,
    "excerpt": "项王乃西从萧，晨击汉军而东，至彭城，日中，大破汉军。"
  },
  {
    "id": "sj7-gaixia",
    "text": "shi-ji",
    "juan": 7,
    "juanTitle": "项羽本纪",
    "layer": "正文",
    "edition": "中华书局点校本",
    "page": "—",
    "pageUnverified": true,
    "excerpt": "项王军壁垓下，兵少食尽，汉军及诸侯兵围之数重。"
  },
  {
    "id": "sj8-lu",
    "text": "shi-ji",
    "juan": 8,
    "juanTitle": "高祖本纪",
    "layer": "正文",
    "edition": "中华书局点校本",
    "page": "—",
    "pageUnverified": true,
    "excerpt": "高祖为亭长时，常告归之田。吕后与两子居田中耨。"
  },
  {
    "id": "sj53-jian",
    "text": "shi-ji",
    "juan": 53,
    "juanTitle": "萧相国世家",
    "layer": "正文",
    "edition": "中华书局点校本",
    "page": "—",
    "pageUnverified": true,
    "excerpt": "何曰：「必欲争天下，非韩信无所与计事者。顾王策安所决耳。」"
  },
  {
    "id": "sj55-hongmen",
    "text": "shi-ji",
    "juan": 55,
    "juanTitle": "留侯世家",
    "layer": "正文",
    "edition": "中华书局点校本",
    "page": "—",
    "pageUnverified": true,
    "excerpt": "良乃入，具告沛公。沛公大惊，曰：「为之奈何？」"
  },
  {
    "id": "sj56-yunmeng",
    "text": "shi-ji",
    "juan": 56,
    "juanTitle": "陈丞相世家",
    "layer": "正文",
    "edition": "中华书局点校本",
    "page": "—",
    "pageUnverified": true,
    "excerpt": "陈平曰：「古者天子巡狩，会诸侯。南方有云梦，陛下弟出伪游云梦，会诸侯于陈。陈，楚之西界，信闻天子以好出游，其势必无事而郊迎谒。谒，而陛下因擒之，此特一力士之事耳。」"
  },
  {
    "id": "sj91-feng",
    "text": "shi-ji",
    "juan": 91,
    "juanTitle": "黥布列传",
    "layer": "正文",
    "edition": "中华书局点校本",
    "page": "—",
    "pageUnverified": true,
    "excerpt": "项王封诸将，立布为九江王，都六。"
  },
  {
    "id": "sj91-jiang",
    "text": "shi-ji",
    "juan": 91,
    "juanTitle": "黥布列传",
    "layer": "正文",
    "edition": "中华书局点校本",
    "page": "—",
    "pageUnverified": true,
    "excerpt": "汉王使随何往说九江王布，布果如何言，起兵攻楚。"
  },
  {
    "id": "sj91-fan",
    "text": "shi-ji",
    "juan": 91,
    "juanTitle": "黥布列传",
    "layer": "正文",
    "edition": "中华书局点校本",
    "page": "—",
    "pageUnverified": true,
    "excerpt": "十一年，淮南王布反。"
  },
  {
    "id": "sj92-bai",
    "text": "shi-ji",
    "juan": 92,
    "juanTitle": "淮阴侯列传",
    "layer": "正文",
    "edition": "中华书局点校本",
    "page": "—",
    "pageUnverified": true,
    "excerpt": "于是王欲召信拜之。何曰：「王素慢无礼，今拜大将如呼小儿耳，此乃信所以去也。王必欲拜之，择良日，斋戒，设坛场，具礼，乃可耳。」"
  },
  {
    "id": "sj92-jingxing",
    "text": "shi-ji",
    "juan": 92,
    "juanTitle": "淮阴侯列传",
    "layer": "正文",
    "edition": "中华书局点校本",
    "page": "—",
    "pageUnverified": true,
    "excerpt": "信乃使万人先行，出，背水陈。赵军望见而大笑。"
  },
  {
    "id": "sj92-yunmeng",
    "text": "shi-ji",
    "juan": 92,
    "juanTitle": "淮阴侯列传",
    "layer": "正文",
    "edition": "中华书局点校本",
    "page": "—",
    "pageUnverified": true,
    "excerpt": "高祖用陈平奇计，乃伪游云梦，会诸侯于陈，楚王信迎谒，因执之。"
  },
  {
    "id": "sj92-lu",
    "text": "shi-ji",
    "juan": 92,
    "juanTitle": "淮阴侯列传",
    "layer": "正文",
    "edition": "中华书局点校本",
    "page": "—",
    "pageUnverified": true,
    "excerpt": "吕后使武士缚信，斩之长乐钟室。"
  },
  {
    "id": "hs1-gaixia",
    "text": "han-shu",
    "juan": 1,
    "juanTitle": "高帝纪",
    "layer": "正文",
    "edition": "中华书局点校本",
    "page": "—",
    "pageUnverified": true,
    "excerpt": "五年冬十月，汉王追项羽至阳夏南，止军，与齐王信、魏相国越期会击楚。"
  },
  {
    "id": "hs31-julu",
    "text": "han-shu",
    "juan": 31,
    "juanTitle": "陈胜项籍传",
    "layer": "正文",
    "edition": "中华书局点校本",
    "page": "—",
    "pageUnverified": true,
    "excerpt": "羽乃悉引兵渡河，已渡，皆湛船，破釜甑，烧庐舍，持三日粮，视士必死，无还心。"
  },
  {
    "id": "hs31-hongmen",
    "text": "han-shu",
    "juan": 31,
    "juanTitle": "陈胜项籍传",
    "layer": "正文",
    "edition": "中华书局点校本",
    "page": "—",
    "pageUnverified": true,
    "excerpt": "范增数目羽击沛公，羽不应。"
  },
  {
    "id": "hs34-xin",
    "text": "han-shu",
    "juan": 34,
    "juanTitle": "韩彭英卢吴传",
    "layer": "正文",
    "edition": "中华书局点校本",
    "page": "—",
    "pageUnverified": true,
    "excerpt": "汉王授韩信左丞相，击魏。"
  },
  {
    "id": "hs34-yunmeng",
    "text": "han-shu",
    "juan": 34,
    "juanTitle": "韩彭英卢吴传",
    "layer": "正文",
    "edition": "中华书局点校本",
    "page": "—",
    "pageUnverified": true,
    "excerpt": "于是上赦以为淮阴侯。"
  },
  {
    "id": "hs39-jian",
    "text": "han-shu",
    "juan": 39,
    "juanTitle": "萧何曹参传",
    "layer": "正文",
    "edition": "中华书局点校本",
    "page": "—",
    "pageUnverified": true,
    "excerpt": "何曰：「必欲争天下，非信无可与计事者。」"
  },
  {
    "id": "hs40-liang",
    "text": "han-shu",
    "juan": 40,
    "juanTitle": "张陈王周传",
    "layer": "正文",
    "edition": "中华书局点校本",
    "page": "—",
    "pageUnverified": true,
    "excerpt": "良曰：「沛公自度能却项羽乎？」"
  },
  {
    "id": "hs40-yunmeng",
    "text": "han-shu",
    "juan": 40,
    "juanTitle": "张陈王周传",
    "layer": "正文",
    "edition": "中华书局点校本",
    "page": "—",
    "pageUnverified": true,
    "excerpt": "平曰：「陛下弟出伪游云梦，会诸侯于陈。陈，楚之西界，信闻天子以好出，其势必郊迎谒。而陛下因擒之，此特一力士之事耳。」"
  },
  {
    "id": "tj9-yunmeng",
    "text": "tongjian",
    "juan": 9,
    "juanTitle": "资治通鉴",
    "layer": "互证",
    "edition": "中华书局点校本",
    "page": "—",
    "pageUnverified": true,
    "excerpt": "汉高祖用陈平计，伪游云梦，会诸侯于陈，楚王信谒，因执之。"
  }
]
